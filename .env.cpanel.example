# Copy this file to the deployed project root as .env and replace every placeholder.
APP_ENV=production

# cPanel MySQL databases and users usually include the account prefix.
MYSQL_HOST=localhost
MYSQL_DATABASE=cpuser_bitacora
MYSQL_USER=cpuser_bitacora
MYSQL_PASSWORD=change_this_database_password

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_AUTH=true
SMTP_USER=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=bitacora@example.com
SMTP_VERIFY_TLS=true
SMTP_TIMEOUT_SECONDS=20
SMTP_HELO_NAME=bitacora.example.com

SESSION_SECURE=true
SESSION_SAMESITE=Lax
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_MAX_LIFETIME_SECONDS=43200
BITACORA_STORAGE_PATH=/home/CPUSER/apps/bitacora-mw/storage/bitacoras_pdf
BITACORA_PDF_TTL_DAYS=90
BITACORA_DRAFT_TTL_DAYS=30
BITACORA_DRAFT_MAX_BYTES=262144
# Generate once with: openssl rand -base64 32
BITACORA_DRAFT_KEY_BASE64=replace_with_base64_of_32_random_bytes
BITACORA_DRAFT_KEYRING_JSON=
BITACORA_DRAFT_ACTIVE_KEY_VERSION=1

# cPanel does not provide the Docker worker, so synchronous mail is the safe default.
BITACORA_MAIL_ASYNC=false
BITACORA_SUBMISSION_CLAIM_TTL_SECONDS=300
APP_ENABLE_LEGACY_BITACORA=false
